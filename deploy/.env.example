# ---- MySQL（你服务器上已有的容器）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=baiflow
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# ---- Redis（你服务器上已有的容器）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 管理员账号 ----
# 不再通过环境变量预置。首次启动后到 Web 端 /setup 按向导创建第一个管理员，
# 初始化令牌在 `docker compose logs server` 里打印（也落在数据目录的 setup-token.txt）。

# ---- 数据目录（宿主机路径，bind mount 进容器；文件/头像/笔记媒体都在这里）----
BAIFLOW_DATA_DIR=/data/baiflow

# ---- 镜像来源（生产从 GHCR 拉取时用；本地源码构建可忽略）----
# 镜像命名空间（小写）。推 tag 发版时 release.yml 会自动把这两个键写进本文件。
# 也可以手填：改成你自己的 GitHub 账号/组织，如 ghcr.io/your-name
BAIFLOW_IMAGE_NAMESPACE=ghcr.io/your-account
# 镜像版本：填 v1.2.3 这样的 tag 或 latest；回滚 = 改成旧版本号再 docker compose pull
BAIFLOW_IMAGE_TAG=latest
