# ---- MySQL（你服务器上已有的容器）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=baiflow
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# ---- Redis（你服务器上已有的容器）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- BaiFlow 初始管理员（首次启动自动创建）----
BAIFLOW_ADMIN=admin
BAIFLOW_ADMIN_PASSWORD=change-me

# ---- 数据目录（宿主机路径，bind mount 进容器；文件/头像/笔记媒体都在这里）----
BAIFLOW_DATA_DIR=/data/baiflow
