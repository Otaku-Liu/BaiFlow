<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BaiFlow" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/primary</item>
        <!-- 窗口背景设为应用底色，避免语言切换等 Activity 重建时黑/白闪烁 -->
        <item name="android:windowBackground">@color/background</item>
        <!-- 统一弹窗圆角：MaterialAlertDialogBuilder 读取，16dp 圆角全局生效（appcompat 的 alertDialogTheme 语义不匹配、已弃用，见 docs/15） -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaiFlow.Dialog</item>
    </style>

    <!-- 圆角弹窗：16dp 圆角，所有 AlertDialog 共用 -->
    <style name="ShapeAppearance.BaiFlow.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.BaiFlow.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BaiFlow.Dialog</item>
    </style>

    <!-- Apple 风格 Design Token，与 Web 端统一 -->
    <color name="primary">#007AFF</color>
    <color name="primary_dark">#0066D6</color>
    <color name="accent">#007AFF</color>
    <color name="accent_light">#5AC8FA</color>
    <color name="white">#FFFFFF</color>
    <color name="text_primary">#1D1D1F</color>
    <color name="text_secondary">#86868B</color>
    <color name="background">#F5F5F7</color>
    <color name="divider">#E5E5EA</color>
    <color name="danger">#FF3B30</color>
    <!-- 头像占位底色/边框（浅灰，与 Web 端 el-avatar 默认底一致） -->
    <color name="avatar_bg">#C0C4CC</color>
    <!-- 头像底部「编辑」色带：半透明黑（照片隐约透出）+ 白字 -->
    <color name="avatar_edit_bg">#99000000</color>
    <color name="avatar_edit_text">#FFFFFF</color>

    <!-- 富文本编辑器专用（代码块/行内代码底色） -->
    <color name="code_bg">#F2F2F7</color>
    <color name="inline_code_bg">#F2F2F7</color>

    <string name="app_name">BaiFlow</string>
</resources>
