<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     BaiFlow iOS 风格设计系统 — 组件样式集中定义
     所有布局引用 @style/Ios.* 继承，改一处全局生效。
     新增组件请遵循本文件与 docs/08-ios-design-system.md。
     ============================================================ -->
<resources>

    <!-- 隐式父级基样式（点分号命名约定需要） -->
    <style name="Ios" />

    <!-- ==================== 按钮 ==================== -->

    <!-- 基础按钮：扁平、圆角、无阴影（iOS 风格） -->
    <style name="Ios.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 主操作（蓝） -->
    <style name="Ios.Button.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 危险操作（红） -->
    <style name="Ios.Button.Danger">
        <item name="backgroundTint">#FF3B30</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 文字按钮（链接式，如"上传/下载"） -->
    <style name="Ios.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- ==================== 输入框 ==================== -->

    <!-- 圆角 Outlined 输入框 -->
    <style name="Ios.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ==================== 标题栏 ==================== -->

    <!-- 顶部标题栏容器：无阴影，与内容区连续 -->
    <style name="Ios.Header">
        <item name="android:background">@color/white</item>
    </style>

    <!-- 标题：居中 -->
    <style name="Ios.Header.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 返回按钮上的上一级名称 -->
    <style name="Ios.Header.BackLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

</resources>
