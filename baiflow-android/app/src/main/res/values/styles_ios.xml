<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     BaiFlow iOS 风格设计系统 — 组件样式集中定义
     所有布局引用 @style/Ios.* 继承，改一处全局生效。
     新增组件请遵循本文件与 docs/07-ios-design-system.md。
     ============================================================ -->
<resources>

    <!-- 隐式父级基样式（点分号命名约定需要） -->
    <style name="Ios" />

    <!-- ==================== 按钮 ==================== -->

    <!-- 基础按钮：扁平、圆角、无阴影（iOS 风格） -->
    <style name="Ios.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 主操作（蓝） -->
    <style name="Ios.Button.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 危险操作（白底红字，如退出登录；去按压投影） -->
    <style name="Ios.Button.DangerOutline">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 文字按钮（链接式，如"上传/下载/保存"）— 与返回按钮共用一个按压样式：背景不变、按下变浅蓝 -->
    <style name="Ios.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_accent_selector</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 弹窗动作行（长摁弹窗）：整行可点、48dp 高、水波纹按压；危险项（如立即删除）由布局覆盖为红色 -->
    <style name="Ios.DialogAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- ==================== 输入框 ==================== -->

    <!-- 圆角 Outlined 输入框 -->
    <style name="Ios.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ==================== 标题栏 ==================== -->

    <!-- 顶部标题栏容器：无阴影，与内容区连续 -->
    <style name="Ios.Header">
        <item name="android:background">@color/white</item>
    </style>

    <!-- 标题：居中 -->
    <style name="Ios.Header.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 返回按钮上的上一级名称（按下/长按时变浅蓝，背景不变） -->
    <style name="Ios.Header.BackLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_accent_selector</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- 设置分组小标题 -->
    <style name="Ios.SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <!-- ==================== 富文本编辑器工具栏 ==================== -->

    <!-- 工具栏按钮（文本式，如 B / I / H1 / 列表 / 更多），激活态由代码改文字颜色 -->
    <style name="Ios.ToolbarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 工具栏容器行 -->
    <style name="Ios.ToolbarRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@color/white</item>
    </style>

</resources>
