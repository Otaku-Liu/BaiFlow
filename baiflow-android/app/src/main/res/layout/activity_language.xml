<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部返回头 -->
    <FrameLayout
        style="@style/Ios.Header"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            style="@style/Ios.Header.Title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/mine_language" />

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.baiflow.android.widget.AnimatedTintImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_return"
                android:tint="@color/text_accent_selector"
                android:duplicateParentState="true"
                android:contentDescription="@string/common_back" />

            <com.baiflow.android.widget.AnimatedTextLabel
                style="@style/Ios.Header.BackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_mine"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 内容区：语言卡片 -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:id="@+id/rowChinese"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:foreground="@drawable/bg_ripple_top">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mine_language_chinese"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbChinese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/rowEnglish"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:foreground="@drawable/bg_ripple_bottom">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mine_language_english"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
