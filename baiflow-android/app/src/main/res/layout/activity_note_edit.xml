<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部标题栏：返回 + 居中标题 + 预览/保存（与返回同高、无点击水波） -->
    <FrameLayout
        style="@style/Ios.Header"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Ios.Header.Title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="middle" />

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.baiflow.android.widget.AnimatedTintImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_return"
                android:tint="@color/text_accent_selector"
                android:duplicateParentState="true"
                android:contentDescription="@string/common_back" />

            <com.baiflow.android.widget.AnimatedTextLabel
                style="@style/Ios.Header.BackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_title"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:text="@string/common_save"
            android:textSize="16sp"
            android:textColor="@color/accent" />
    </FrameLayout>

    <!-- 标题输入 -->
    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:hint="@string/note_edit_title_hint"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 工具栏（常显）：块类型 + 媒体，竖线分隔，与 Web 一致 -->
    <HorizontalScrollView
        android:id="@+id/toolbarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/white">

        <LinearLayout
            style="@style/Ios.ToolbarRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockText"
                style="@style/Ios.ToolbarButton"
                android:text="@string/note_block_text" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockHeading"
                style="@style/Ios.ToolbarButton"
                android:text="@string/note_block_heading" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImage"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_image"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudio"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_mic"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDraw"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_draw"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 格式栏（常显第二行）：加粗 / 斜体 / 下划线 / 删除线。
         选中文字后点击应用，再点一次取消；focusable=false 不抢焦点，保住选中不丢失 -->
    <HorizontalScrollView
        android:id="@+id/formatRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/white">

        <LinearLayout
            style="@style/Ios.ToolbarRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolbarBold"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_bold"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary"
                android:focusable="false"
                android:contentDescription="@string/note_edit_bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolbarItalic"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_italic"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary"
                android:focusable="false"
                android:contentDescription="@string/note_edit_italic" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolbarUnderline"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_underline"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary"
                android:focusable="false"
                android:contentDescription="@string/note_edit_underline" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolbarStrike"
                style="@style/Ios.ToolbarButton"
                app:icon="@drawable/ic_tool_strike"
                app:iconSize="20dp"
                app:iconTint="@color/text_primary"
                android:focusable="false"
                android:contentDescription="@string/note_edit_strike" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 正文块编辑器（RecyclerView，每块一个真实 View） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBlocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />

</LinearLayout>
