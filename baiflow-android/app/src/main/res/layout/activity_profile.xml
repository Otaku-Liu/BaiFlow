<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部返回头 -->
    <FrameLayout
        style="@style/Ios.Header"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            style="@style/Ios.Header.Title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/mine_profile" />

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.baiflow.android.widget.AnimatedTintImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_return"
                android:tint="@color/text_accent_selector"
                android:duplicateParentState="true"
                android:contentDescription="@string/common_back" />

            <com.baiflow.android.widget.AnimatedTextLabel
                style="@style/Ios.Header.BackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_mine"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 内容区 -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp"
        android:gravity="top">

        <!-- 头像：预览 + 更换按钮 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <TextView
                    android:id="@+id/tvAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_avatar" />

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_avatar_border"
                    android:visibility="gone"
                    android:contentDescription="@string/mine_change_avatar" />
            </FrameLayout>

            <com.baiflow.android.widget.AnimatedTextButton
                android:id="@+id/btnChangeAvatar"
                style="@style/Ios.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:text="@string/mine_change_avatar" />

            <com.baiflow.android.widget.AnimatedTextButton
                android:id="@+id/btnDeleteAvatar"
                style="@style/Ios.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:textColor="@color/danger"
                android:visibility="gone"
                android:text="@string/mine_delete_avatar" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mine_display_name_hint"
            style="@style/Ios.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.baiflow.android.widget.AnimatedTextButton
            android:id="@+id/btnSave"
            style="@style/Ios.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/common_save" />

    </LinearLayout>

</LinearLayout>
