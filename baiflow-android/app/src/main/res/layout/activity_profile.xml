<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部返回头 -->
    <FrameLayout
        style="@style/Ios.Header"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            style="@style/Ios.Header.Title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/mine_profile" />

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.baiflow.android.widget.AnimatedTintImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_return"
                android:tint="@color/text_accent_selector"
                android:duplicateParentState="true"
                android:contentDescription="@string/common_back" />

            <com.baiflow.android.widget.AnimatedTextLabel
                style="@style/Ios.Header.BackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_mine"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 内容区 -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp"
        android:gravity="top">

        <!-- 头像：居中，整圆（含底部「编辑」带）点击弹出动作面板（更换/删除头像） -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <!-- background 提供圆形 outline 供 clipToOutline 裁切子视图；水波纹改挂 foreground -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:background="@drawable/bg_avatar"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mine_change_avatar">

                <TextView
                    android:id="@+id/tvAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textColor="@color/white" />

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_avatar_border"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

                <!-- 编辑带：贴底矩形，被父容器圆形 outline 裁成弓形；上传中改显「上传中…」 -->
                <TextView
                    android:id="@+id/tvAvatarEditBand"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:text="@string/mine_avatar_edit"
                    android:textSize="12sp"
                    android:textColor="@color/avatar_edit_text"
                    android:background="@color/avatar_edit_bg"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mine_display_name_hint"
            style="@style/Ios.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.baiflow.android.widget.AnimatedTextButton
            android:id="@+id/btnSave"
            style="@style/Ios.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/common_save" />

    </LinearLayout>

</LinearLayout>
